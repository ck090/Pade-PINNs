Computing [3/3] temporal Padé approximant for 2D Allen-Cahn equation...
 f0=sin(x)*sin(pi*y)
 f1=-pi**2*kappa*sin(x)*sin(pi*y) - kappa*sin(x)*sin(pi*y)
 f2=kappa**2*sin(x)*sin(pi*y) + 2*pi**2*kappa**2*sin(x)*sin(pi*y) + pi**4*kappa**2*sin(x)*sin(pi*y)
 f3=-pi**6*kappa**3*sin(x)*sin(pi*y) - 3*pi**4*kappa**3*sin(x)*sin(pi*y) - 3*pi**2*kappa**3*sin(x)*sin(pi*y) - kappa**3*sin(x)*sin(pi*y)
 f4=kappa**4*sin(x)*sin(pi*y) + 4*pi**2*kappa**4*sin(x)*sin(pi*y) + 6*pi**4*kappa**4*sin(x)*sin(pi*y) + 4*pi**6*kappa**4*sin(x)*sin(pi*y) + pi**8*kappa**4*sin(x)*sin(pi*y)
 f5=-pi**10*kappa**5*sin(x)*sin(pi*y) - 5*pi**8*kappa**5*sin(x)*sin(pi*y) - 10*pi**6*kappa**5*sin(x)*sin(pi*y) - 10*pi**4*kappa**5*sin(x)*sin(pi*y) - 5*pi**2*kappa**5*sin(x)*sin(pi*y) - kappa**5*sin(x)*sin(pi*y)
 f6=kappa**6*sin(x)*sin(pi*y) + 6*pi**2*kappa**6*sin(x)*sin(pi*y) + 15*pi**4*kappa**6*sin(x)*sin(pi*y) + 20*pi**6*kappa**6*sin(x)*sin(pi*y) + 15*pi**8*kappa**6*sin(x)*sin(pi*y) + 6*pi**10*kappa**6*sin(x)*sin(pi*y) + pi**12*kappa**6*sin(x)*sin(pi*y)
 b0=1 (normalised)
 b1=kappa*(1 + pi**2)/2
 b2=kappa**2*(1 + 2*pi**2 + pi**4)/10
 b3=kappa**3*(1 + 3*pi**2 + 3*pi**4 + pi**6)/120
 a0=sin(x)*sin(pi*y)
 a1=kappa*(-pi**2 - 1)*sin(x)*sin(pi*y)/2
 a2=kappa**2*(1 + 2*pi**2 + pi**4)*sin(x)*sin(pi*y)/10
 a3=kappa**3*(-pi**6 - 3*pi**4 - 3*pi**2 - 1)*sin(x)*sin(pi*y)/120
 P[3/3](x,t) = (kappa**3*t**3*(-pi**6 - 3*pi**4 - 3*pi**2 - 1)*sin(x)*sin(pi*y)/120 + kappa**2*t**2*(1 + 2*pi**2 + pi**4)*sin(x)*sin(pi*y)/10 + kappa*t*(-pi**2 - 1)*sin(x)*sin(pi*y)/2 + sin(x)*sin(pi*y))/(kappa**3*t**3*(1 + 3*pi**2 + 3*pi**4 + pi**6)/120 + kappa**2*t**2*(1 + 2*pi**2 + pi**4)/10 + kappa*t*(1 + pi**2)/2 + 1)

